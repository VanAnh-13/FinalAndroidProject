<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardElevation="@dimen/elevation_button"
    app:cardCornerRadius="@dimen/corner_radius"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_normal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/view_indicator"
            android:layout_width="@dimen/spacing_small"
            android:layout_height="@dimen/spacing_small"
            android:background="@drawable/bg_icon_rounded"
            android:backgroundTint="@color/error_red"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_normal">

            <TextView
                android:id="@+id/tv_alert_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_medium"
                tools:text="Nhịp tim cao bất thường: 130 bpm"/>

            <TextView
                android:id="@+id/tv_alert_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_small"
                android:layout_marginTop="@dimen/spacing_tiny"
                tools:text="15/10/2023"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
