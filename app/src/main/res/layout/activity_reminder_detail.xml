<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:paddingStart="@dimen/padding_normal"
                android:paddingEnd="@dimen/padding_normal">

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:src="@drawable/ic_arrow_back"
                    android:padding="@dimen/padding_medium"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    app:tint="@color/text_primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/reminder_detail"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/iv_back"
                    app:layout_constraintEnd_toStartOf="@id/iv_delete"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <ImageView
                    android:id="@+id/iv_delete"
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:src="@drawable/ic_delete"
                    android:padding="@dimen/padding_medium"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/delete"
                    app:tint="@color/text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Icon + Title Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="@dimen/padding_xl"
                android:paddingBottom="@dimen/padding_normal"
                android:paddingStart="@dimen/padding_normal"
                android:paddingEnd="@dimen/padding_normal">

                <FrameLayout
                    android:layout_width="@dimen/icon_size_xlarge"
                    android:layout_height="@dimen/icon_size_xlarge"
                    android:background="@drawable/bg_icon_rounded"
                    android:backgroundTint="@color/primary_container"
                    android:layout_marginBottom="@dimen/spacing_normal">

                    <ImageView
                        android:id="@+id/iv_reminder_icon"
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_medication"
                        app:tint="@color/primary"/>

                </FrameLayout>

                <TextView
                    android:id="@+id/tv_reminder_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_xxl"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:text="Morning Medication"/>

                <TextView
                    android:id="@+id/tv_reminder_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_medium"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/spacing_small"
                    tools:text="Take with a full glass of water, 30 minutes before breakfast."/>

            </LinearLayout>

            <!-- Segmented Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_segmented_button"
                android:layout_margin="@dimen/spacing_normal"
                android:padding="@dimen/spacing_tiny">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mark_taken"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_medium"
                    android:layout_weight="1"
                    android:text="@string/mark_taken"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_small"
                    android:textAllCaps="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="@dimen/corner_radius_large"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_skip_reminder"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_medium"
                    android:layout_weight="1"
                    android:text="@string/skip"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_small"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="@dimen/corner_radius_large"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reschedule"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_medium"
                    android:layout_weight="1"
                    android:text="@string/reschedule"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_small"
                    android:textAllCaps="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="@dimen/corner_radius_large"/>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/border_color"
                android:layout_marginStart="@dimen/spacing_normal"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <!-- Information List Items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_normal"
                android:paddingEnd="@dimen/padding_normal"
                android:paddingTop="@dimen/padding_normal"
                android:paddingBottom="@dimen/padding_normal">

                <!-- Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_item_height"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingBottom="@dimen/spacing_small">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/ic_time"
                        android:padding="@dimen/padding_medium"
                        app:tint="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tv_time_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        tools:text="08:00 AM, Today"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_medium"/>

                </LinearLayout>

                <!-- Repeats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_item_height"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingBottom="@dimen/spacing_small">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/ic_repeat"
                        android:padding="@dimen/padding_medium"
                        app:tint="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tv_repeat_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        tools:text="Daily"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/repeats"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_medium"/>

                </LinearLayout>

                <!-- Medication -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_item_height"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingBottom="@dimen/spacing_small">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/ic_medication"
                        android:padding="@dimen/padding_medium"
                        app:tint="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tv_medication_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        tools:text="Metformin 500mg"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/medication"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_medium"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/border_color"
                android:layout_marginStart="@dimen/spacing_normal"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <!-- Notes Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_normal"
                app:cardElevation="0dp"
                app:cardCornerRadius="@dimen/corner_radius"
                android:backgroundTint="@color/primary_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_normal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notes"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <TextView
                        android:id="@+id/tv_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_medium"
                        android:lineSpacingExtra="@dimen/spacing_tiny"
                        tools:text="Remember to check blood sugar levels before taking this medication, especially if feeling dizzy."/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@color/background_light"
        android:padding="@dimen/padding_normal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_reminder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/edit_reminder"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/corner_radius_large"
            app:backgroundTint="@color/primary"
            android:layout_marginBottom="@dimen/spacing_medium"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_reminder"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/delete_reminder"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/corner_radius_large"
            app:strokeColor="@color/primary"
            app:strokeWidth="@dimen/stroke_width"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
