<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/margin_normal">
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/health_analytics_title"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@android:color/black" />
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/refresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:textSize="@dimen/text_size_small" />
    </LinearLayout>

    <!-- Cache Info -->
    <TextView
        android:id="@+id/tv_cache_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cached_info"
        android:textSize="@dimen/text_size_small"
        android:textColor="@android:color/darker_gray"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/margin_small" />

    <!-- Time Range Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="@dimen/margin_normal">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_7_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/days_7"
            style="@style/Widget.Material3.Button.OutlinedButton" />
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_30_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/days_30"
            style="@style/Widget.Material3.Button.OutlinedButton" />
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_90_days"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/days_90"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminate="true" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:spacing="16dp">

            <!-- Blood Pressure Chart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_background"
                android:padding="@dimen/padding_medium"
                android:layout_marginBottom="@dimen/margin_medium">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blood_pressure_chart_title"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_small" />
                
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_blood_pressure"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_large"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp" />
                
                <TextView
                    android:id="@+id/tv_blood_pressure_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blood_pressure_stats_placeholder"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="@dimen/margin_small" />
            </LinearLayout>

            <!-- Blood Sugar Chart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_background"
                android:padding="@dimen/padding_medium"
                android:layout_marginBottom="@dimen/margin_medium">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blood_sugar_chart_title"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_small" />
                
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_blood_sugar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_large"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp" />
                
                <TextView
                    android:id="@+id/tv_blood_sugar_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/blood_sugar_stats_placeholder"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="@dimen/margin_small" />
            </LinearLayout>

            <!-- Weight Chart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_background"
                android:padding="@dimen/padding_medium"
                android:layout_marginBottom="@dimen/margin_medium">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/weight_chart_title"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_small" />
                
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_weight"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_large"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp" />
                
                <TextView
                    android:id="@+id/tv_weight_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/weight_stats_placeholder"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="@dimen/margin_small" />
            </LinearLayout>

            <!-- Heart Rate Chart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_background"
                android:padding="@dimen/padding_medium"
                android:layout_marginBottom="@dimen/margin_medium">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_rate_chart_title"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_small" />
                
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_heart_rate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_large"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp" />
                
                <TextView
                    android:id="@+id/tv_heart_rate_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_rate_stats_placeholder"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="@dimen/margin_small" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
