<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/auto"
    style="@style/StandardEmptyState">

    <ImageView
        android:id="@+id/iv_empty_icon"
        style="@style/StandardEmptyState.Icon" />

    <TextView
        android:id="@+id/tv_empty_title"
        style="@style/StandardEmptyState.Title" />

    <TextView
        android:id="@+id/tv_empty_description"
        style="@style/StandardEmptyState.Description" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_empty_action"
        style="@style/StandardButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:visibility="gone" />

</LinearLayout>