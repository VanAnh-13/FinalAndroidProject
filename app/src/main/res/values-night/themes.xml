<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme for the application -->
    <style name="Base.Theme.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors for dark mode -->
        <item name="colorPrimary">@color/primary_red_dark_mode</item>
        <item name="colorPrimaryVariant">@color/primary_red_darker</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/primary_red_light_dark_mode</item>
        <item name="colorOnSecondary">@color/text_primary_dark</item>
        
        <!-- Background colors for dark mode -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        
        <!-- Status bar for dark mode -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <style name="Theme.Base" parent="Base.Theme.Base" />
</resources>