<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name=".HealthyLifeHubApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/protection"
        android:label="@string/app_name"
        android:roundIcon="@drawable/protection"
        android:supportsRtl="true"
        android:theme="@style/Theme.Base"
        tools:targetApi="31">
        <activity
            android:name=".ui.onboarding.WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.metrics.detail.MetricDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.actions.QuickActionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.edit.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.history.MedicalHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.notifications.center.NotificationsCenterActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.metrics.add_edit.AddEditMetricActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.reminders.add_edit.AddEditReminderActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.reminders.detail.ReminderDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.reminders.suggestions.SmartSuggestionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.records.timeline.RecordsTimelineActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.records.add_edit.AddEditRecordActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.records.detail.RecordDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.medicines.list.MedicinesListActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.medicines.add.AddMedicineActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.reports.ExportReportsActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.metrics.analysis.MetricAnalysisActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.metrics.anomaly.AnomalyAlertActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.settings.NotificationSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.privacy.PrivacySecurityActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.privacy.LoginHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.privacy.LegalDocumentActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.profile.help.HelpSupportActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.analytics.enhanced.EnhancedAnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.notifications.NotificationHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Base"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".receivers.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".receivers.ReminderActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".receivers.NotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".receivers.DeadlineExtensionReceiver"
            android:enabled="true"
            android:exported="false" />
        
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
